{
  "name": "prophey",
  "private": true,
  "version": "0.6.26",
  "description": "Prophey — a coding agent desktop client",
  "author": "eriol touwa",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "npm run dev -w @prophey/desktop",
    "start": "npm run start -w @prophey/desktop",
    "build": "npm run build -w @prophey/desktop",
    "dist": "npm run dist -w @prophey/desktop",
    "release": "npm run release -w @prophey/desktop",
    "typecheck": "npm run typecheck -w @prophey/desktop",
    "test:smoke": "node scripts/smoke-electron.cjs",
    "test:handoff": "node scripts/test-handoff.cjs",
    "test:crash": "node scripts/test-composer-crash.cjs"
  }
}
